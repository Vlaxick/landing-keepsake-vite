mixin picture(name, alt, width, height, lazy = true)
  picture
    if name.startsWith('work-')
      source(type='image/avif' srcset=`images/${name}-180.avif 180w, images/${name}.avif 358w` sizes='(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 358px')
      source(type='image/webp' srcset=`images/${name}-180.webp 180w, images/${name}.webp 358w` sizes='(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 358px')
    else
      source(type='image/avif' srcset=`images/${name}-75.avif 75w, images/${name}.avif 150w` sizes='(min-width: 768px) 150px, 96px')
      source(type='image/webp' srcset=`images/${name}-75.webp 75w, images/${name}.webp 150w` sizes='(min-width: 768px) 150px, 96px')
    img(src=`images/${name}.jpg` width=width height=height alt=alt decoding='async' loading=(lazy ? 'lazy' : null))
