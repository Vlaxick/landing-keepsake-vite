section.section.clients-section#clients(aria-labelledby='clients-title')
  .container
    h2.section-title#clients-title Clients & kind words
    p.section-intro Some of the teams that trusted us with their brands.
    .client-logos(role='group' aria-label='Client names')
      each client in clients
        span= client.name
    figure.testimonial
      span.quote-mark(aria-hidden='true') “
      blockquote Keepsake turned a vague brief into a brand we are proud of. The team was fast, honest about trade-offs and obsessed with the details.
      .slider-dots(role='group' aria-label='Testimonial 1 of 3')
        each dot, i in [1, 2, 3]
          span(class={selected: i === 0})
      figcaption
        span.avatar(aria-hidden='true') OM
        span
          strong Olena Marchenko
          small Marketing Lead, Nordly
