header.site-header
  .container.header-inner
    a.brand(href='#top' aria-label='Keepsake home')
      svg.brand-logo(viewBox='0 0 112 40' width='112' height='40' aria-hidden='true' focusable='false')
        circle.brand-logo__circle(cx='20' cy='20' r='20')
        text.brand-logo__initial(x='20' y='29' text-anchor='middle') K
        text.brand-logo__name(x='39' y='29') eepsake
    nav.desktop-nav(aria-label='Main navigation')
      each item, index in navigation
        a(href=item.href class={active: index === 0} aria-current=(index === 0 ? 'page' : null))= item.label
      a.favourite(href='#works' aria-label='View favourite works')
        +icon('heart')
    //-  Native HTML popover supports show/hide without any JavaScript. 
    button.menu-toggle(type='button' popovertarget='mobile-menu' popovertargetaction='toggle' aria-controls='mobile-menu' aria-label='Toggle mobile navigation')
      span
      span
      span
