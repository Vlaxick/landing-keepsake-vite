section#works.section.works-section(aria-labelledby='works-title')
  .container
    h2#works-title.section-title Our awesome works
    .portfolio
      each category, i in categories
        input.filter-input(
          class=`filter-input--${category.id}`,
          type='radio',
          name='work-filter',
          id=`filter-${category.id}`,
          checked=i === 0
        )
      input#show-more.show-more-check(type='checkbox')
      .chips(role='group', aria-label='Filter projects by category')
        each category in categories
          label(for=`filter-${category.id}`)= category.label
      .work-grid
        each work in works
          +work-card(work)
      label.btn.btn--outline.load-more(for='show-more')
        span.load-more-label Load more works
        span.show-less-label Show fewer works
